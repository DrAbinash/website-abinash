# Dr Abinash Kumar website - Environment Configuration
# Copy to .env and adjust as needed.

# SQLite database file path (persisted via Docker volume in production)
DATABASE_URL=file:/app/data/abinash.db

# Optional: admin password for the /admin/enquiries page (cookie-based auth).
# The in-page Admin Panel (gear button) uses a separate DB-stored password
# (default "admin123", changeable from the Settings tab).
# ADMIN_PASSWORD=changeme

# Public address of THIS website. Used for the canonical URL, sitemap.xml and
# robots.txt, so it must be the address patients see in the browser bar.
# Leave unset and the site falls back to https://abinash.caredeoghar.com.
# Do NOT put the hospital's address here (hope.caredeoghar.com is a different
# site): pointing the canonical tag at another host tells Google this page is a
# duplicate of that one, and it will not rank this site.
SITE_URL=https://abinash.caredeoghar.com
