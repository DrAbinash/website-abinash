# Dr Abinash Kumar website - Environment Configuration
# Copy to .env and adjust as needed.

# SQLite database file path (persisted via Docker volume in production)
DATABASE_URL=file:/app/data/abinash.db

# Optional: admin password for the /admin/enquiries page (cookie-based auth).
# The in-page Admin Panel (gear button) uses a separate DB-stored password
# (default "admin123", changeable from the Settings tab).
# ADMIN_PASSWORD=changeme

# Public site URL (used for sitemap + canonical URL)
NEXT_PUBLIC_SITE_URL=https://hope.caredeoghar.com

# ------------------------------------------------------------
# Online booking. The "Book Appointment" buttons point at /book,
# which 302-redirects to the Care ERP (caredeoghar.com) — Care runs
# the online booking + ICICI Orange Pay gateway, so this site never
# handles payment or card data itself.
#
# Append query params to deep-link a package, e.g.
#   https://caredeoghar.com/book?packageCode=ABINASH
# CARE_BOOKING_SOURCE tags the booking for attribution on Care.
# ------------------------------------------------------------
CARE_BOOKING_URL=https://caredeoghar.com/book
# CARE_BOOKING_SOURCE=abinash
